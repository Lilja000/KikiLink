# Staging template, never a usable secret file. Production requires reviewed deployment configuration.
CLOUD_MODE=staging
CLOUD_BIND=127.0.0.1
CLOUD_PORT=8791
CLOUD_VERIFIER_PORT=8792
CLOUD_ORIGIN=https://cloud-staging.example.invalid
CLOUD_ALLOWED_ORIGINS=https://bondageprojects.elementfx.com
CLOUD_TEST_MEMBERS=REPLACE_WITH_APPROVED_TEST_MEMBER_NUMBERS
CLOUD_MODERATORS=REPLACE_WITH_APPROVED_ADMIN_MEMBER_NUMBER
CLOUD_VERIFIER_MEMBER=REPLACE_WITH_PINNED_VERIFIER_MEMBER_NUMBER
CLOUD_VERIFIER_SECRET=GENERATE_SEPARATE_32_BYTE_BASE64URL_SECRET
CLOUD_RATE_SECRET=GENERATE_SEPARATE_32_BYTE_BASE64URL_SECRET
CLOUD_KEY_RING={"staging-1":"GENERATE_32_RANDOM_BYTES_BASE64"}
CLOUD_ACTIVE_KEY=staging-1
CLOUD_DB=/var/lib/kikilink-cloud/cloud.sqlite
R2_ENDPOINT=https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=kikilink-cloud-staging-media
R2_BACKUP_BUCKET=kikilink-cloud-staging-backups
R2_ACCESS_KEY_ID=REPLACE_WITH_BUCKET_SCOPED_ACCESS_KEY
R2_SECRET_ACCESS_KEY=REPLACE_WITH_BUCKET_SCOPED_SECRET
