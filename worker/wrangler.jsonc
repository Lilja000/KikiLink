{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kikilink-catbox-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "UPLOADS_ENABLED": "false",
    "GLOBAL_DAILY_UPLOADS": "100",
    "GLOBAL_DAILY_BYTES": "2147483648",
    "GLOBAL_MAX_CONCURRENT": "2"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "UPLOAD_SESSIONS",
        "class_name": "UploadSessionLedger"
      },
      {
        "name": "GLOBAL_UPLOAD_LEDGER",
        "class_name": "GlobalUploadLedger"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UploadSessionLedger", "GlobalUploadLedger"]
    }
  ],
  "ratelimits": [
    {
      "name": "SESSION_RATE_LIMITER",
      "namespace_id": "64001",
      "simple": {
        "limit": 6,
        "period": 60
      }
    },
    {
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "64002",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  }
}
